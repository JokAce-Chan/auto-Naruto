<Window x:Class="NaruttoTimer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="替身计时器" Height="760" Width="1320" MinHeight="620" MinWidth="1080"
        Background="#0E1013" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1A1D23" BorderBrush="#2A2F38" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="#2E6FD0" Margin="0,0,10,0">
                        <TextBlock Text="★" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="替身计时器" Foreground="#E6E8EC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Text="NaruttoTimer v0.2 · AI/传统双模式" Foreground="#6B7480" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#16191E" BorderBrush="#2A2F38" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="620"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="DeviceDot" Width="9" Height="9" CornerRadius="5" Background="#6B7480" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DeviceText" Text="雷电模拟器" Foreground="#9AA3B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="BtnRefresh" Content="刷新设备" Style="{StaticResource ToolbarButton}" Click="BtnRefresh_Click"/>
                    <ComboBox x:Name="DeviceCombo" Width="190" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"
                              Background="#F2F4F7" Foreground="#000000" BorderBrush="#8A93A0"
                              ItemContainerStyle="{StaticResource LightComboItem}" IsEditable="False"/>
                    <Button x:Name="BtnConnect" Content="连接" Style="{StaticResource ToolbarButton}" Click="BtnConnect_Click"/>
                    <Button x:Name="BtnStart" Content="开始识别" Style="{StaticResource ToolbarButton}" Click="BtnStart_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="实时预览" Foreground="#9AA3B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ToggleButton x:Name="PreviewToggle" Width="34" Height="18" IsChecked="True" Click="PreviewToggle_Click"/>
                    </StackPanel>
                    <TextBlock Text="模式" Foreground="#9AA3B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ModeCombo" Width="110" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"
                              Background="#F2F4F7" Foreground="#000000" BorderBrush="#8A93A0"
                              ItemContainerStyle="{StaticResource LightComboItem}" IsEditable="False"
                              SelectionChanged="ModeCombo_SelectionChanged"/>
                    <Button x:Name="BtnLabelConfig" Content="区域标注" Style="{StaticResource ToolbarButton}" Click="BtnLabelConfig_Click"/>
                    <Button x:Name="BtnDumpFrame" Content="导出帧" Style="{StaticResource ToolbarButton}" Click="BtnDumpFrame_Click"/>
                    <Button x:Name="BtnData" Content="数据保存" Style="{StaticResource ToolbarButton}" Click="BtnData_Click"/>
                    <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource ToolbarButton}" Click="BtnSettings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左预览 + 右控制面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区 -->
            <Border Grid.Column="0" Margin="14" CornerRadius="8" Background="#0D1B2E" BorderBrush="#2A3B52" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" VerticalAlignment="Top" Visibility="Collapsed"/>
                    <Canvas x:Name="PreviewCanvas" Visibility="Collapsed" ClipToBounds="True"/>
                    <Border x:Name="PreviewOffMask" Background="#AA0E1013" Visibility="Collapsed">
                        <TextBlock Text="预览已关闭／仅识别" Foreground="#8FA3BC" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PreviewPlaceholder" Text="预览区：未连接设备" Foreground="#5F7A99" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 控制面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14,14,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="识别状态"/>
                            <TextBlock x:Name="RecLeftText" Style="{StaticResource CardBody}" Text="左  值 -- · 倒计时 0.00"/>
                            <TextBlock x:Name="RecRightText" Style="{StaticResource CardBody}" Text="右  值 -- · 倒计时 0.00"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="置顶框设置"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="位置锁定"/>
                                <ToggleButton x:Name="LockToggle" Width="34" Height="18" IsChecked="False" Margin="10,0,0,0" Click="LockToggle_Click"/>
                                <TextBlock x:Name="LockValue" Style="{StaticResource CardBody}" Text="未锁定" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="背景透明度"/>
                                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="90" Value="55" Width="140" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OpacityValue" Style="{StaticResource CardBody}" Text="55%" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="数字透明度"/>
                                <Slider x:Name="TextOpacitySlider" Minimum="0" Maximum="100" Value="100" Width="140" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextOpacityValue" Style="{StaticResource CardBody}" Text="100%" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardBody}" Text="背景与数字透明度独立设置；显示格式：0.00  0.00（无括号 · 随框缩放）" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="识别模式与参数"/>
                            <TextBlock x:Name="ModeText" Style="{StaticResource CardBody}" Text="模式：--"/>
                            <TextBlock x:Name="ParamText" Style="{StaticResource CardBody}" Text="参数：--"/>
                            <TextBlock x:Name="ModelText" Style="{StaticResource CardBody}" Text="模型：--"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="区域标注"/>
                            <TextBlock x:Name="LabelText" Style="{StaticResource CardBody}" Text="左能量条：--"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="左右能量条强制同高同步宽（AI 模式垂直拼接推理）；可在预览区直接拖拽调整。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="触发规则说明"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="值 = 4 − 空豆数（AI 模型/传统采样）；连续 3 帧稳定后才参与判定。"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="稳定值恰好「减 1」→ 视为使用替身/技能，该侧倒计时重置为 14.5s。"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="每帧都参与判定；倒计时归零后保持 0.00。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#16191E" BorderBrush="#2A2F38" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="● 未连接" Foreground="#9AA3B0" FontSize="11"/>
                <TextBlock x:Name="FpsText" Text="FPS --" Foreground="#9AA3B0" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock x:Name="InferText" Text="推理 --" Foreground="#9AA3B0" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock x:Name="VideoText" Text="视频流 --" Foreground="#9AA3B0" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock x:Name="LogText" DockPanel.Dock="Right" Text="日志：--" Foreground="#7EC3FF" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
