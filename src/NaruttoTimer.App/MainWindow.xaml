<Window x:Class="NaruttoTimer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="替身计时器" Height="720" Width="1240" MinHeight="600" MinWidth="1000"
        Background="#0E1013" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1A1D23" BorderBrush="#2A2F38" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="#2E6FD0" Margin="0,0,10,0">
                        <TextBlock Text="◆" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="替身计时器" Foreground="#E6E8EC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="NaruttoTimer v0.1 · 开发中" Foreground="#6B7480" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Content="&#x2014;" Width="34" Background="Transparent" BorderThickness="0" Foreground="#9AA3B0" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="&#x25A1;" Width="34" Background="Transparent" BorderThickness="0" Foreground="#9AA3B0" Click="BtnMaximize_Click"/>
                    <Button x:Name="BtnClose" Content="&#x2715;" Width="34" Background="Transparent" BorderThickness="0" Foreground="#FF5C5C" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="#16191E" BorderBrush="#2A2F38" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="DeviceDot" Width="9" Height="9" CornerRadius="5" Background="#6B7480" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="DeviceText" Text="雷电模拟器 emulator-7834" Foreground="#9AA3B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="BtnRefresh" Content="刷新设备" Style="{StaticResource ToolbarButton}" Click="BtnRefresh_Click"/>
                    <ComboBox x:Name="DeviceCombo" Width="180" Margin="0,0,8,0" VerticalAlignment="Center"
                              Background="#FFFFFF" Foreground="#000000" BorderBrush="#8A93A0"
                              IsEditable="False"/>
                    <Button x:Name="BtnConnect" Content="连接" Style="{StaticResource ToolbarButton}" Click="BtnConnect_Click"/>
                    <Button x:Name="BtnStart" Content="开始识别" Style="{StaticResource ToolbarButton}" Click="BtnStart_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="实时预览" Foreground="#9AA3B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ToggleButton x:Name="PreviewToggle" Width="34" Height="18" IsChecked="True" Click="PreviewToggle_Click"/>
                    </StackPanel>
                    <Button x:Name="BtnCalibrate" Content="取色校准" Style="{StaticResource ToolbarButton}" Click="BtnCalibrate_Click"/>
                    <Button x:Name="BtnRoi" Content="区域配置" Style="{StaticResource ToolbarButton}" Click="BtnRoi_Click"/>
                    <Button x:Name="BtnData" Content="数据保存" Style="{StaticResource ToolbarButton}" Click="BtnData_Click"/>
                    <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource ToolbarButton}" Click="BtnSettings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主体：左预览 + 右控制面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 预览区 -->
            <Border Grid.Column="0" Margin="14" CornerRadius="8" Background="#0D1B2E" BorderBrush="#2A3B52" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" VerticalAlignment="Top" Visibility="Collapsed"/>
                    <Canvas x:Name="PreviewCanvas" Visibility="Collapsed"/>
                    <Canvas x:Name="PreviewCellCanvas" Visibility="Collapsed"/>
                    <Border x:Name="PreviewOffMask" Background="#AA0E1013" Visibility="Collapsed">
                        <TextBlock Text="预览已关闭·识别照跑" Foreground="#8FA3BC" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PreviewPlaceholder" Text="预览区：未连接设备" Foreground="#5F7A99" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border x:Name="PreviewOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                            Background="#8CFFFFFF" CornerRadius="10" Padding="14,6" Visibility="Collapsed">
                        <TextBlock x:Name="PreviewOverlayText" Text="0.00    0.00" Foreground="#1F9D55" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 控制面板 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14,14,14">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="识别状态"/>
                            <TextBlock x:Name="RecLeftText" Style="{StaticResource CardBody}" Text="左  格数 -- · 值 -- · 倒计时 0.00 · 未运行"/>
                            <TextBlock x:Name="RecRightText" Style="{StaticResource CardBody}" Text="右  格数 -- · 值 -- · 倒计时 0.00 · 未运行"/>
                            <TextBlock x:Name="RoundText" Style="{StaticResource CardBody}" Text="回合切换检测：等待识别"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="置顶框设置"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="位置锁定"/>
                                <ToggleButton x:Name="LockToggle" Width="34" Height="18" IsChecked="False" Margin="10,0,0,0" Click="LockToggle_Click"/>
                                <TextBlock x:Name="LockValue" Style="{StaticResource CardBody}" Text="未锁定" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="背景透明度"/>
                                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="90" Value="55" Width="140" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OpacityValue" Style="{StaticResource CardBody}" Text="55%" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource CardBody}" Text="数字透明度"/>
                                <Slider x:Name="TextOpacitySlider" Minimum="0" Maximum="100" Value="100" Width="140" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TextOpacityValue" Style="{StaticResource CardBody}" Text="100%" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardBody}" Text="显示格式：0.00  0.00（无括号 · 随框缩放）" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="亮 / 暗颜色阈值"/>
                            <TextBlock x:Name="BrightThresholdText" Style="{StaticResource CardBody}" Text="亮：天蓝系 RGB(180-255,120-255,120-255)（默认，待采样优化）"/>
                            <TextBlock x:Name="DarkThresholdText" Style="{StaticResource CardBody}" Text="暗：深蓝黑 RGB(0-60,0-60,0-90)（默认，待采样优化）"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="值=4 突变：偏橙红（采样时单独归类）"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="区域配置"/>
                            <TextBlock x:Name="RoiText" Style="{StaticResource CardBody}" Text="区域A（左）：待框选&#10;区域B（右）：待框选"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="格数模式：自动（4↔6），6格向屏幕中心延伸"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="触发规则说明"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="值恰好减1 → 启动/重置 15.00s；增、减≥2 → 不动作不打断。"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="格数变化4↔6 → 不触发，新值继承不超上限。"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="加载动画中 → 不计不重置；重新稳定识别后置 0.00。"/>
                            <TextBlock Style="{StaticResource CardBody}" Text="归零后保持显示 0.00；左右独立并行。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#16191E" BorderBrush="#2A2F38" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="● 未连接" Foreground="#9AA3B0" FontSize="11"/>
                <TextBlock x:Name="FpsText" Text="FPS --" Foreground="#9AA3B0" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock x:Name="VideoText" Text="视频流 --" Foreground="#9AA3B0" FontSize="11" Margin="16,0,0,0"/>
                <TextBlock x:Name="LogText" DockPanel.Dock="Right" Text="日志：--" Foreground="#7EC3FF" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
